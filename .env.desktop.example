# Copy to .env.desktop and adjust values for your machine.

# Spring Boot
SERVER_PORT=8083

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_JUDGE_MODELS=qwen2.5:7b,qwen2.5:3b,qwen2.5:1.5b
OLLAMA_EMBED_MODEL=bge-m3:latest

# Bilibili daily rank
BILIBILI_DAILY_RANK_URL=https://api.bilibili.com/x/web-interface/ranking/v2?rid=3&type=all
BILIBILI_DAILY_RANK_TIMEOUT_MS=8000
BILIBILI_DAILY_RANK_CACHE_SECONDS=600

# Daily recommend weights
RECOMMEND_DAILY_PERSONAL_WEIGHT=0.7
RECOMMEND_DAILY_RANK_WEIGHT=0.3

# Redis (optional but recommended)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms
REDIS_ENABLED=false

# MySQL (optional; if you use DB features)
MYSQL_URL=jdbc:mysql://localhost:3306/bilibili_music?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
DB_ENABLED=false

# Desktop launcher behavior
BILIBILI_MUSIC_OPEN_BROWSER=true
BILIBILI_MUSIC_FORCE_REBUILD=false
BILIBILI_MUSIC_OLLAMA_AUTO_START=true

# Media
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
YTDLP_COOKIES=
MEDIA_DOWNLOAD_DIR=downloads

# Observability / online learning (optional)
TRACING_ENABLED=false
ONLINE_LEARNING_TRAINING_ENABLED=false

# Agent execution
AGENT_EXECUTION_DEFAULT_MAX_DURATION_MS=180000
AGENT_PREFETCH_SCORING_ENABLED=false
